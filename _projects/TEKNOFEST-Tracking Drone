      #include <chrono>
      #include <memory>
      #include "rclcpp/rclcpp.hpp"
      #include "mavros_msgs/msg/attitude_target.hpp"
      #include "mavros_msgs/msg/state.hpp"
      #include "mavros_msgs/srv/set_mode.hpp"
      #include "sensor_msgs/msg/joy.hpp"
      #include <tf2/LinearMath/Quaternion.h>

      using namespace std::chrono_literals;

      class FullFlowchartSim : public rclcpp::Node {
      public:
        FullFlowchartSim() : Node("aero_track_gcs_node") {
          att_pub_ = this->create_publisher<mavros_msgs::msg::AttitudeTarget>(
            "mavros/setpoint_raw/attitude", 10);
          set_mode_client_ = this->create_client<mavros_msgs::srv::SetMode>(
            "mavros/set_mode");
          state_sub_ = this->create_subscription<mavros_msgs::msg::State>(
            "mavros/state", 10,
            std::bind(&FullFlowchartSim::state_callback, this, std::placeholders::_1));
          joy_sub_ = this->create_subscription<sensor_msgs::msg::Joy>(
            "joy", 10,
            std::bind(&FullFlowchartSim::joy_callback, this, std::placeholders::_1));
          timer_ = this->create_wall_timer(
            50ms, std::bind(&FullFlowchartSim::timer_callback, this));
          last_mode_switch_ = this->get_clock()->now();
        }

      private:
        void state_callback(const mavros_msgs::msg::State::SharedPtr msg) {
          current_state_ = *msg;
        }

        void joy_callback(const sensor_msgs::msg::Joy::SharedPtr msg) {
          latest_joy_ = *msg;
          joy_received_ = true;
          auto now = this->get_clock()->now();
          // 1s debounce to prevent MAVROS crash from rapid mode switching
          if ((now - last_mode_switch_).seconds() > 1.0) {
            if (msg->buttons.size() > 2) {
              if (msg->buttons[0] == 1) { set_flight_mode("0");  last_mode_switch_ = now; } // STABILIZE
              if (msg->buttons[1] == 1) { set_flight_mode("2");  last_mode_switch_ = now; } // ALT_HOLD
              if (msg->buttons[2] == 1) { set_flight_mode("20"); last_mode_switch_ = now; } // GUIDED_NOGPS
            }
          }
        }

        void set_flight_mode(const std::string& mode_id) {
          if (!set_mode_client_->wait_for_service(1s)) return;
          auto request = std::make_shared<mavros_msgs::srv::SetMode::Request>();
          request->custom_mode = mode_id;
          // Async call prevents blocking the main telemetry thread
          set_mode_client_->async_send_request(request,
            [this, mode_id](rclcpp::Client<mavros_msgs::srv::SetMode>::SharedFuture future) {});
        }

        void timer_callback() {
          if (!joy_received_) return;
          bool is_ai_mode = (current_state_.mode == "GUIDED_NOGPS" ||
                             current_state_.mode == "20");
          if (is_ai_mode) {
            // [REPLACE WITH PPO AGENT OUTPUT]
            const double MAX_TILT_RAD = 0.523;
            double roll   = latest_joy_.axes[3] * MAX_TILT_RAD * -1.0;
            double pitch  = latest_joy_.axes[4] * MAX_TILT_RAD;
            double yaw    = latest_joy_.axes[0] * MAX_TILT_RAD;
            double thrust = (latest_joy_.axes[1] + 1.0) / 2.0;

            tf2::Quaternion q;
            q.setRPY(roll, pitch, yaw);

            auto att_msg = mavros_msgs::msg::AttitudeTarget();
            att_msg.header.stamp = this->get_clock()->now();
            att_msg.header.frame_id = "base_link";
            att_msg.type_mask = 7;
            att_msg.orientation.w = q.w(); att_msg.orientation.x = q.x();
            att_msg.orientation.y = q.y(); att_msg.orientation.z = q.z();
            att_msg.thrust = thrust;
            att_pub_->publish(att_msg);
          }
        }

        rclcpp::TimerBase::SharedPtr timer_;
        rclcpp::Publisher<mavros_msgs::msg::AttitudeTarget>::SharedPtr att_pub_;
        rclcpp::Client<mavros_msgs::srv::SetMode>::SharedPtr set_mode_client_;
        rclcpp::Subscription<mavros_msgs::msg::State>::SharedPtr state_sub_;
        rclcpp::Subscription<sensor_msgs::msg::Joy>::SharedPtr joy_sub_;
        rclcpp::Time last_mode_switch_;
        mavros_msgs::msg::State current_state_;
        sensor_msgs::msg::Joy latest_joy_;
        bool joy_received_ = false;
      };

      int main(int argc, char* argv[]) {
        rclcpp::init(argc, argv);
        rclcpp::spin(std::make_shared<FullFlowchartSim>());
        rclcpp::shutdown();
        return 0;
      }

